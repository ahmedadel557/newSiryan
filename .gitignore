# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/

# Environment variables — never commit real secrets
# Base .env (non-secret defaults) is committed
apps/backend/.env.development
apps/backend/.env.production
apps/backend/.env.local
apps/backend/.env.*.local
apps/frontend/.env*.local
apps/frontend/.env.production

# Logs
logs/
*.log

# Turbo cache
.turbo/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Backend uploads (keep placeholder)
apps/backend/uploads/avatars/*
!apps/backend/uploads/avatars/.gitkeep

# Seed credentials — generated once for dev seeding, must never be committed
apps/backend/seed-credentials.txt

# Misc
.DS_Store
*.pem

deploy/nginx-frontend.conf