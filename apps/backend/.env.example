PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/siryan_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@siryan.xyz
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
FRONTEND_URL=http://localhost:3000
STREAM_API_KEY=
STREAM_API_SECRET=

# E2E testing: requests with a matching x-e2e-key header bypass the global rate limiter.
# Leave empty to disable the bypass entirely.
E2E_RATE_LIMIT_KEY=
